{
  "name": "@gorth-io/primitive",
  "version": "0.0.0-alpha.6",
  "description": "Shared shadcn-based UI package",
  "type": "module",
  "author": "Gorthenburg",
  "license": "GORTH",
  "private": false,
  "keywords": [
    "gorth",
    "shadcn",
    "ui",
    "react",
    "client"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gorth-io/base-primitive.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "style": "./src/styles/globals.css",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "src/styles",
    "src/assets"
  ],
  "engines": {
    "node": "24.x"
  },
  "packageManager": "bun@1.4.4",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./cores/lucide": {
      "types": "./dist/cores/lucide.d.ts",
      "import": "./dist/cores/lucide.js",
      "default": "./dist/cores/lucide.js"
    },
    "./cores/*": {
      "types": "./dist/cores/*.d.ts",
      "import": "./dist/cores/*.js",
      "default": "./dist/cores/*.js"
    },
    "./cores/*/*": {
      "types": "./dist/cores/*/*.d.ts",
      "import": "./dist/cores/*/*.js",
      "default": "./dist/cores/*/*.js"
    },
    "./utils/*": {
      "types": "./dist/utils/*.d.ts",
      "import": "./dist/utils/*.js",
      "default": "./dist/utils/*.js"
    },
    "./lib/*": {
      "types": "./dist/lib/*.d.ts",
      "import": "./dist/lib/*.js",
      "default": "./dist/lib/*.js"
    },
    "./hooks/*": {
      "types": "./dist/hooks/*.d.ts",
      "import": "./dist/hooks/*.js",
      "default": "./dist/hooks/*.js"
    },
    "./modules/*": {
      "types": "./dist/modules/*.d.ts",
      "import": "./dist/modules/*.js",
      "default": "./dist/modules/*.js"
    },
    "./default/*": {
      "types": "./dist/components/ui/*.d.ts",
      "import": "./dist/components/ui/*.js",
      "default": "./dist/components/ui/*.js"
    },
    "./pattern/*": {
      "types": "./dist/components/io/*.d.ts",
      "import": "./dist/components/io/*.js",
      "default": "./dist/components/io/*.js"
    },
    "./layouts/*": {
      "types": "./dist/layouts/*.d.ts",
      "import": "./dist/layouts/*.js",
      "default": "./dist/layouts/*.js"
    },
    "./providers/*": {
      "types": "./dist/providers/*.d.ts",
      "import": "./dist/providers/*.js",
      "default": "./dist/providers/*.js"
    },
    "./pages/*": {
      "types": "./dist/pages/*.d.ts",
      "import": "./dist/pages/*.js",
      "default": "./dist/pages/*.js"
    },
    "./block/*": {
      "types": "./dist/components/block/*.d.ts",
      "import": "./dist/components/block/*.js",
      "default": "./dist/components/block/*.js"
    },
    "./custom/*": {
      "types": "./dist/components/custom/*.d.ts",
      "import": "./dist/components/custom/*.js",
      "default": "./dist/components/custom/*.js"
    },
    "./background/*": {
      "types": "./dist/components/background/*.d.ts",
      "import": "./dist/components/background/*.js",
      "default": "./dist/components/background/*.js"
    },
    "./element/*": {
      "types": "./dist/components/element/*.d.ts",
      "import": "./dist/components/element/*.js",
      "default": "./dist/components/element/*.js"
    },
    "./dashboard/*": {
      "types": "./dist/components/dashboard/*.d.ts",
      "import": "./dist/components/dashboard/*.js",
      "default": "./dist/components/dashboard/*.js"
    },
    "./icons/*": {
      "types": "./dist/components/icons/*.d.ts",
      "import": "./dist/components/icons/*.js",
      "default": "./dist/components/icons/*.js"
    },
    "./assets/*": {
      "import": "./src/assets/*",
      "default": "./src/assets/*"
    },
    "./globals.css": {
      "import": "./src/styles/globals.css",
      "default": "./src/styles/globals.css"
    },
    "./illustration/*": {
      "types": "./dist/components/illustration/*.d.ts",
      "import": "./dist/components/illustration/*.js",
      "default": "./dist/components/illustration/*.js"
    },
    "./miscellaneous/*": {
      "types": "./dist/components/miscellaneous/*.d.ts",
      "import": "./dist/components/miscellaneous/*.js",
      "default": "./dist/components/miscellaneous/*.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown --minify",
    "prepack": "bun run build",
    "update": "bun update",
    "error": "bun run build",
    "dev": "tsdown --watch",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "shadcn": "shadcn add --all --override"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@bprogress/core": "^1.3.4",
    "@bprogress/next": "^3.2.12",
    "@bprogress/react": "^1.2.7",
    "@shadcn/helpers": "^0.3.0",
    "@shadcn/react": "^0.3.1",
    "@tanstack/ai": "^1.0.1",
    "@tanstack/ai-react": "^1.0.1",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.105.3",
    "@tanstack/react-ranger": "^0.0.5",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-table": "^9.3.1",
    "@tanstack/react-virtual": "^3.14.26",
    "axios": "^1.21.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "color": "^5.0.3",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^14.9.1",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.68.0",
    "media-chrome": "^4.19.4",
    "motion": "^14.9.1",
    "react-day-picker": "^10.0.2",
    "react-dropzone": "^20.1.4",
    "react-fast-marquee": "^1.6.5",
    "react-image-crop": "^11.1.2",
    "react-medium-image-zoom": "^5.4.9",
    "react-resizable-panels": "^4.18.0",
    "react-svg-credit-card-payment-icons": "^6.0.4",
    "react-use-measure": "^2.1.7",
    "recharts": "3.8.0",
    "shadcn": "^4.23.0",
    "shiki": "^4.6.0",
    "simplex-noise": "^4.0.3",
    "sonner": "^2.0.8",
    "swr": "^2.5.1",
    "tailwind-merge": "^3.7.0",
    "three": "^0.187.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2"
  },
  "peerDependencies": {
    "next": "^16.4.5",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    },
    "next-themes": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "eslint": "^9.39.5",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.4",
    "tsdown": "^0.23.5",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
