{
  "name": "@gorth/primitive",
  "version": "3.1.5",
  "description": "Shared shadcn-based UI package",
  "type": "module",
  "author": "Gorthenburg",
  "license": "GORTH",
  "private": true,
  "keywords": [
    "gorth",
    "shadcn",
    "ui",
    "react"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/goraria/base-primitive.git"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "style": "./src/styles/globals.css",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./cores/lucide": {
      "types": "./dist/cores/lucide.d.ts",
      "import": "./dist/cores/lucide.js",
      "default": "./dist/cores/lucide.js"
    },
    "./cores/*": {
      "types": "./dist/cores/*.d.ts",
      "import": "./dist/cores/*.js",
      "default": "./dist/cores/*.js"
    },
    "./cores/*/*": {
      "types": "./dist/cores/*/*.d.ts",
      "import": "./dist/cores/*/*.js",
      "default": "./dist/cores/*/*.js"
    },
    "./lib/*": {
      "types": "./dist/lib/*.d.ts",
      "import": "./dist/lib/*.js",
      "default": "./dist/lib/*.js"
    },
    "./hooks/*": {
      "types": "./dist/hooks/*.d.ts",
      "import": "./dist/hooks/*.js",
      "default": "./dist/hooks/*.js"
    },
    "./modules/*": {
      "types": "./dist/modules/*.d.ts",
      "import": "./dist/modules/*.js",
      "default": "./dist/modules/*.js"
    },
    "./default/*": {
      "types": "./dist/components/ui/*.d.ts",
      "import": "./dist/components/ui/*.js",
      "default": "./dist/components/ui/*.js"
    },
    "./pattern/*": {
      "types": "./dist/components/io/*.d.ts",
      "import": "./dist/components/io/*.js",
      "default": "./dist/components/io/*.js"
    },
    "./layouts/*": {
      "types": "./dist/layouts/*.d.ts",
      "import": "./dist/layouts/*.js",
      "default": "./dist/layouts/*.js"
    },
    "./providers/*": {
      "types": "./dist/providers/*.d.ts",
      "import": "./dist/providers/*.js",
      "default": "./dist/providers/*.js"
    },
    "./pages/*": {
      "types": "./dist/pages/*.d.ts",
      "import": "./dist/pages/*.js",
      "default": "./dist/pages/*.js"
    },
    "./block/*": {
      "types": "./dist/components/block/*.d.ts",
      "import": "./dist/components/block/*.js",
      "default": "./dist/components/block/*.js"
    },
    "./custom/*": {
      "types": "./dist/components/custom/*.d.ts",
      "import": "./dist/components/custom/*.js",
      "default": "./dist/components/custom/*.js"
    },
    "./background/*": {
      "types": "./dist/components/background/*.d.ts",
      "import": "./dist/components/background/*.js",
      "default": "./dist/components/background/*.js"
    },
    "./element/*": {
      "types": "./dist/components/element/*.d.ts",
      "import": "./dist/components/element/*.js",
      "default": "./dist/components/element/*.js"
    },
    "./dashboard/*": {
      "types": "./dist/components/dashboard/*.d.ts",
      "import": "./dist/components/dashboard/*.js",
      "default": "./dist/components/dashboard/*.js"
    },
    "./icons/*": {
      "types": "./dist/components/icons/*.d.ts",
      "import": "./dist/components/icons/*.js",
      "default": "./dist/components/icons/*.js"
    },
    "./assets/*": {
      "import": "./src/assets/*",
      "default": "./src/assets/*"
    },
    "./globals.css": {
      "import": "./src/styles/globals.css",
      "default": "./src/styles/globals.css"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsdown --minify",
    "prepack": "pnpm build",
    "update": "pnpm update",
    "error": "pnpm build",
    "dev": "tsdown --watch",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "shadcn": "pnpm dlx shadcn@latest add -a -o",
    "shadcn:ui": "pnpm dlx shadcn@latest add -o -p src/components/ui",
    "shadcn:ui:all": "pnpm dlx shadcn@latest add -a -o -p src/components/ui",
    "shadcn:io": "pnpm dlx shadcn@latest add -o -p src/components/io",
    "shadcn:ui:list": "bash ./scripts/shadcn-ui-list.sh",
    "shadcn:io:list": "bash ./scripts/shadcn-io-list.sh",
    "shadcn:io:backgrounds": "bash ./scripts/shadcn-io-backgrounds.sh",
    "shadcn:io:hooks": "bash ./scripts/shadcn-io-hooks.sh"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@bprogress/core": "^1.3.4",
    "@bprogress/next": "^3.2.12",
    "@bprogress/react": "^1.2.7",
    "@shadcn/helpers": "^0.2.0",
    "@shadcn/react": "^0.3.1",
    "@tanstack/ai": "^0.68.0",
    "@tanstack/ai-react": "^0.30.3",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-ranger": "^0.0.5",
    "@tanstack/react-router": "^1.170.42",
    "@tanstack/react-table": "^9.2.8",
    "@tanstack/react-virtual": "^3.14.14",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "color": "^5.0.3",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^14.1.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.55.0",
    "media-chrome": "^4.19.3",
    "motion": "^14.1.0",
    "react-day-picker": "^10.0.2",
    "react-dropzone": "^20.1.3",
    "react-fast-marquee": "^1.6.5",
    "react-image-crop": "^11.1.2",
    "react-medium-image-zoom": "^5.4.9",
    "react-resizable-panels": "^4.14.3",
    "react-svg-credit-card-payment-icons": "^6.0.4",
    "react-use-measure": "^2.1.7",
    "recharts": "3.10.1",
    "shadcn": "^4.21.4",
    "shiki": "^4.5.0",
    "simplex-noise": "^4.0.3",
    "sonner": "^2.0.8",
    "swr": "^2.5.1",
    "tailwind-merge": "^3.7.0",
    "three": "^0.186.1",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2"
  },
  "peerDependencies": {
    "next": "^16.4.0",
    "next-themes": "^0.4.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    },
    "next-themes": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "eslint": "^9.39.5",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "tsdown": "^0.23.0",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@10.33.4"
}
